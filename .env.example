# Copy to .env.local for local dev. In production set these in
# Vercel -> Project -> Settings -> Environment Variables.

# --- Database (Postgres; Neon via the Vercel Marketplace works well) ---
# Use the POOLED connection string.
DATABASE_URL=

# --- Site ---
NEXT_PUBLIC_SITE_NAME="Faisal's Stock List"
NEXT_PUBLIC_APP_URL=https://your-domain.com
# Markup added to every seller price, in dollars
MARKUP_DOLLARS=10
# Hide listings the seller hasn't re-posted in this many days
LISTING_TTL_DAYS=7

# --- AI (Claude reads the group messages and seller replies) ---
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# --- WhatsApp gateway (Whapi.cloud) ---
WHAPI_TOKEN=
# Random string; also goes in the webhook URL you give Whapi:
#   https://your-domain.com/api/whatsapp/webhook?secret=<this>
WHATSAPP_WEBHOOK_SECRET=
# Comma-separated group ids to capture (see Admin -> WhatsApp inbox).
# Leave empty to capture every group the bot's number is in.
WHATSAPP_GROUP_IDS=
# Your own WhatsApp number (digits, with country code) for order alerts
ADMIN_WHATSAPP_NUMBER=

# --- Seller verification ---
# DM the seller automatically when a buyer requests an item
AUTO_VERIFY=true
# Charge the buyer automatically once the seller confirms (false = you click "charge")
AUTO_CHARGE=true
# Flag orders where the seller hasn't replied after this many hours
VERIFY_REMIND_HOURS=2
# WhatsApp buyers (if they gave a phone) about price changes / confirmations
NOTIFY_BUYERS_WHATSAPP=true

# --- Accounts (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated emails that can open /admin
ADMIN_EMAILS=you@example.com

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
